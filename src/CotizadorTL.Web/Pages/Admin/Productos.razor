@page "/admin/productos"
@inject AuthService Auth
@inject CatalogoService Catalogo
@inject Supabase.Client Supa
@inject NavigationManager Nav

<PageTitle>Productos</PageTitle>

@if (!Auth.EsAdmin)
{
    <p>No tienes acceso a esta sección.</p>
}
else if (cargando)
{
    <p>Cargando…</p>
}
else
{
    <h1>Productos</h1>

    <!-- Alta -->
    <section class="card">
        <h2>Nuevo producto</h2>
        <div class="campos">
            <label>Familia
                <select @bind="nFamilia" @bind:after="OnFamiliaNuevoChange">
                    @foreach (var f in Catalogo.Familias) { <option value="@f.Codigo">@f.Nombre</option> }
                </select>
            </label>
            <label>Código SAP<input @bind="nCodigo" /></label>
            <label>Nombre<input @bind="nNombre" /></label>
            <label>Tipo de precio
                <select @bind="nTipo">
                    <option value="fijo">Fijo (por pieza)</option>
                    <option value="m2">Por m²</option>
                </select>
            </label>
            <label>Grupo/Tier
                <select @bind="nGrupo">
                    @foreach (var g in GruposDe(nFamilia))
                    { <option value="@g.val">@g.label</option> }
                </select>
            </label>
            <label>Precio (MXN)<input type="number" step="0.0001" @bind="nPrecio" /></label>
            <label class="chk"><input type="checkbox" @bind="nExtra" /> Es extra de locker</label>
            <label class="chk"><input type="checkbox" @bind="nDescuento" /> Lleva descuento de distribuidor</label>
        </div>
        <label class="desc">Descripción<textarea rows="2" @bind="nDesc"></textarea></label>
        <button class="btn-add" @onclick="Agregar" disabled="@guardando">@(guardando ? "Guardando…" : "Agregar producto")</button>
        @if (msg is not null) { <div class="aviso @(ok ? "ok" : "err")">@msg</div> }
    </section>

    <!-- Listado por familia -->
    <section class="card">
        <h2>Productos <span class="muted small">(@Filtrados().Count())</span></h2>
        <div class="filtros">
            <label>Filtrar por familia
                <select @bind="fFamilia">
                    <option value="">Todas</option>
                    @foreach (var f in Catalogo.Familias) { <option value="@f.Codigo">@f.Nombre</option> }
                </select>
            </label>
        </div>
        <div class="tabla-wrap">
            <table class="proyectos">
                <thead><tr><th>Código SAP</th><th>Nombre</th><th>Familia</th><th>Tipo</th><th class="num">Precio(s)</th><th>Extra</th><th>Descuento</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in Filtrados())
                    {
                        <tr>
                            <td><b>@p.CodigoSap</b></td>
                            <td>@p.Nombre</td>
                            <td>@NombreFamilia(p.FamiliaCodigo)</td>
                            <td>@(p.TipoPrecio == "m2" ? "m²" : "fijo")</td>
                            <td class="num">@string.Join(" · ", p.Precios.Select(kv => $"{kv.Key}: {kv.Value:#,##0.##}"))</td>
                            <td>@(p.EsExtra ? "Sí" : "")</td>
                            <td>@(p.AplicaDescuento ? "Sí" : "no")</td>
                            <td>
                                <button class="btn-mini xls" @onclick="() => Editar(p)">Editar</button>
                                <button class="btn-mini pdf" @onclick="() => Eliminar(p)">Eliminar</button>
                            </td>
                        </tr>
                        @if (editandoId == p.ProductoId)
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="campos">
                                        <label>Código SAP<input @bind="eCodigo" /></label>
                                        <label>Nombre<input @bind="eNombre" /></label>
                                        <label>Familia
                                            <select @bind="eFamilia">
                                                @foreach (var f in Catalogo.Familias) { <option value="@f.Codigo">@f.Nombre</option> }
                                            </select>
                                        </label>
                                        <label>Tipo de precio
                                            <select @bind="eTipo">
                                                <option value="fijo">Fijo (por pieza)</option>
                                                <option value="m2">Por m²</option>
                                            </select>
                                        </label>
                                        <label class="chk"><input type="checkbox" @bind="eExtra" /> Es extra de locker</label>
                                        <label class="chk"><input type="checkbox" @bind="eDescuento" /> Lleva descuento de distribuidor</label>
                                        <label class="chk"><input type="checkbox" @bind="eActivo" /> Activo (sale en el cotizador)</label>
                                    </div>
                                    <label class="desc">Descripción (la que va al PDF)<textarea rows="5" @bind="eDesc"></textarea></label>
                                    <button class="btn-add" @onclick="GuardarEdicion" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar cambios")</button>
                                    <button class="btn-mini" style="background:var(--tl-gris-txt);margin-left:.4rem" @onclick="() => editandoId = null">Cancelar</button>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Filtrados().Any())
                    { <tr><td colspan="7" class="muted center">Sin productos.</td></tr> }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private bool cargando = true, guardando;
    private string? msg; private bool ok;
    private string fFamilia = "";
    // alta
    private string nFamilia = "CUBIERTAS", nCodigo = "", nNombre = "", nTipo = "fijo", nGrupo = "G1", nDesc = "";
    private decimal nPrecio;
    private bool nExtra;
    // La instalación y el flete NO llevan descuento. Antes se deducía de la
    // familia, así que un producto de instalación cargado fuera de Servicios
    // salía descontado sin que nadie lo notara.
    private bool nDescuento = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.EsAdmin) { Nav.NavigateTo(""); return; }
        await Catalogo.CargarAsync();
        cargando = false;
    }

    // Grupos válidos por familia (se reflejan en el desplegable)
    private (string val, string label)[] GruposDe(string familia) => familia switch
    {
        "CUBIERTAS" => new[] { ("G1","G1 · Grupo 1"), ("G2","G2 · Grupo 2"), ("G3","G3 · Grupo 3 (core blanco)"),
                               ("G4","G4 · Grupo 4 (UV/exterior)"), ("ESP_INT","Especial interior (+20%)"), ("ESP_EXT","Especial exterior (+20%)") },
        "LOCKERS"   => new[] { ("UNICO","Único (un solo precio)"), ("PRO","PRO"), ("SMART","SMART"),
                               ("3mm","3 mm"), ("6mm","6 mm"), ("9mm","9 mm"), ("12mm","12 mm") },
        "BANCAS"    => new[] { ("G1","G1 · Grupo 1") },
        _           => new[] { ("UNICO","Único (un solo precio)") },  // Servicios, etc.
    };

    private void OnFamiliaNuevoChange()
    {
        var grupos = GruposDe(nFamilia);
        if (!grupos.Any(g => g.val == nGrupo)) nGrupo = grupos[0].val;  // ajusta el grupo al primero válido
        nDescuento = nFamilia != "SERVICIOS";  // se propone; la casilla manda
        StateHasChanged();
    }

    private IEnumerable<Producto> Filtrados() =>
        (string.IsNullOrEmpty(fFamilia) ? Catalogo.Productos : Catalogo.PorFamilia(fFamilia)).OrderBy(p => p.FamiliaCodigo).ThenBy(p => p.Orden);

    private string NombreFamilia(string codigo) => Catalogo.Familias.FirstOrDefault(f => f.Codigo == codigo)?.Nombre ?? codigo;

    private async Task Agregar()
    {
        msg = null;
        if (string.IsNullOrWhiteSpace(nCodigo) || string.IsNullOrWhiteSpace(nNombre)) { ok = false; msg = "Código y nombre son obligatorios."; return; }
        guardando = true;
        try
        {
            var prod = new PProducto
            {
                CodigoSap = nCodigo.Trim(), FamiliaCodigo = nFamilia, Nombre = nNombre.Trim(), Descripcion = nDesc ?? "",
                TipoPrecio = nTipo, Unidad = nTipo == "m2" ? "m2" : "pieza", Moneda = "MXN",
                RequiereMedidas = nTipo == "m2", AplicaDescuento = nDescuento, EsExtra = nExtra, Activo = true, Orden = 999,
            };
            var resp = await Supa.From<PProducto>().Insert(prod);
            var nuevo = resp.Models.First();
            try
            {
                await Supa.From<PProductoPrecio>().Insert(new PProductoPrecio
                {
                    ProductoId = nuevo.ProductoId, Grupo = string.IsNullOrWhiteSpace(nGrupo) ? "UNICO" : nGrupo.Trim(), Precio = nPrecio
                });
            }
            catch
            {
                // Un producto sin precio sale en el catalogo y no se puede cotizar:
                // si el precio no entra, el producto se deshace y no queda a medias.
                await Supa.From<PProducto>().Where(x => x.ProductoId == nuevo.ProductoId).Delete();
                throw;
            }
            await Catalogo.CargarAsync(forzar: true);
            ok = true; msg = $"Producto {nuevo.CodigoSap} agregado.";
            nCodigo = nNombre = nDesc = ""; nPrecio = 0; nExtra = false; nDescuento = nFamilia != "SERVICIOS";
        }
        catch (Exception ex) { ok = false; msg = "No se pudo agregar: " + ex.Message; }
        finally { guardando = false; }
    }

    // ---------- edición ----------
    // Hasta ahora esta pantalla solo daba de alta y borraba, así que corregir una
    // descripción —la que se imprime en el PDF— había que hacerlo por SQL.
    private long? editandoId;
    private string eCodigo = "", eNombre = "", eFamilia = "", eTipo = "fijo", eDesc = "";
    private bool eExtra, eDescuento = true, eActivo = true;

    private void Editar(Producto p)
    {
        msg = null;
        // tocar "Editar" en la fila abierta la cierra
        if (editandoId == p.ProductoId) { editandoId = null; return; }
        editandoId = p.ProductoId;
        eCodigo = p.CodigoSap; eNombre = p.Nombre; eFamilia = p.FamiliaCodigo;
        eTipo = p.TipoPrecio; eDesc = p.Descripcion;
        eExtra = p.EsExtra; eDescuento = p.AplicaDescuento; eActivo = p.Activo;
    }

    private async Task GuardarEdicion()
    {
        if (editandoId is not long id) return;
        if (string.IsNullOrWhiteSpace(eCodigo) || string.IsNullOrWhiteSpace(eNombre))
        { ok = false; msg = "Código y nombre son obligatorios."; return; }
        guardando = true; msg = null;
        try
        {
            var p = Catalogo.Buscar(id);
            if (p is null) { ok = false; msg = "Ese producto ya no está en el catálogo."; return; }
            // Se mandan TODAS las columnas, no solo las que se ven: el Update de
            // supabase-csharp escribe el modelo completo, así que lo que no se
            // edita acá tiene que ir con su valor de ahora o se perdería.
            await Supa.From<PProducto>().Update(new PProducto
            {
                ProductoId = id,
                CodigoSap = eCodigo.Trim(), FamiliaCodigo = eFamilia, Nombre = eNombre.Trim(),
                Descripcion = eDesc ?? "", TipoPrecio = eTipo,
                Unidad = eTipo == "m2" ? "m2" : "pieza", Moneda = p.Moneda, Espesor = p.Espesor,
                RequiereMedidas = eTipo == "m2", MedidaUnica = p.MedidaUnica,
                AplicaDescuento = eDescuento, EsExtra = eExtra, Activo = eActivo, Orden = p.Orden,
            });
            await Catalogo.CargarAsync(forzar: true);
            editandoId = null;
            ok = true; msg = $"Producto {eCodigo.Trim()} actualizado.";
        }
        catch (Exception ex) { ok = false; msg = "No se pudo guardar: " + ex.Message; }
        finally { guardando = false; }
    }

    private async Task Eliminar(Producto p)
    {
        msg = null;
        try
        {
            await Supa.From<PProducto>().Where(x => x.ProductoId == p.ProductoId).Delete();
            await Catalogo.CargarAsync(forzar: true);
            ok = true; msg = $"Producto {p.CodigoSap} eliminado.";
        }
        catch (Exception ex) { ok = false; msg = "No se pudo eliminar (¿usado en cotizaciones?): " + ex.Message; }
    }
}
